{
  "name": "pypr",
  "version": "0.1.0",
  "productName": "Pypr",
  "description": "Lightweight Windows reader for research papers with highlights and notes",
  "main": "./out/main/index.js",
  "author": "Ojaswi",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "com.ojaswi.pypr",
    "productName": "Pypr",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
